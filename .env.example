# Isolated local hackathon mode is the default. Do not put secrets or financial data here.
OLOS_HACKATHON_DEMO_MODE=false
# OLOS_HACKATHON_DATA_DIR=.hackathon-runtime/data

# Hosted judging only: set true and use an ephemeral directory.
# OLOS_HACKATHON_DEMO_MODE=true
# OLOS_HACKATHON_DEMO_DATA_DIR=/tmp/olos-hackathon-budget-demo
